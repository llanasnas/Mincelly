# Copy to .env.local and fill in. .env.local is never committed.

# ── Database (required) ──────────────────────────────────────────────────────
# Neon Postgres connection string. Then run: pnpm db:migrate
DATABASE_URL=postgres://user:password@host.neon.tech/dbname

# ── LLM provider ─────────────────────────────────────────────────────────────
# anthropic | openai | ollama | none
# "none" (or a missing API key) switches to the heuristic, no-AI parser.
LLM_PROVIDER=anthropic

# Offer several providers and let the user pick one in the UI:
# ENABLED_PROVIDERS=anthropic,openai,ollama

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Ollama (local, no API key)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_VISION_MODEL=llama3.2-vision:11b

# ── Nutrition (optional, recommended) ────────────────────────────────────────
# USDA FoodData Central key — free at https://fdc.nal.usda.gov/api-key-signup
# Without it, ingredients outside the bundled reference table are estimated by the LLM.
# USDA_API_KEY=

# ── Recipe photos (optional) ─────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Authentication (optional) ────────────────────────────────────────────────
# true → pages and API routes require a Google sign-in. false → the app is open.
FORCE_LOGIN=false

# Comma-separated allowlist. Empty → any Google account can sign in.
# ALLOWED_EMAILS=you@example.com,family@example.com

# OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Signs the session cookie. At least 32 characters: openssl rand -base64 48
# AUTH_SECRET=

# Public URL, no trailing slash. Inferred from the request when unset.
# APP_URL=https://mincely.example.com
# AUTH_REDIRECT_URL=https://mincely.example.com/api/auth/callback
